# Server-side only. Optional for Vercel to read the private Actions paper ledger.
# Fine-grained GitHub token: this repository only, Contents: Read-only.
NORTHSTAR_STATE_TOKEN=
# Local worker optional settings. Never a brokerage key.
POLL_INTERVAL_MS=60000
# Hosted IBKR relay: Production only; never put real values in this tracked file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted from Vercel Marketplace.
NORTHSTAR_IBKR_INGEST_TOKEN=
NORTHSTAR_IBKR_VIEW_TOKEN=
NORTHSTAR_PUBLIC_ORIGIN=https://northstar-pi-pied.vercel.app
# Local-only uploader; generated in .env.ibkr.local by npm run setup:relay.
NORTHSTAR_IBKR_RELAY_URL=https://northstar-pi-pied.vercel.app/api/ibkr-ingest
